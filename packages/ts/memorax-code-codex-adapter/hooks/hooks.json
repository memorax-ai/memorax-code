{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/runtime-hook.mjs\" ensure-backend",
            "commandWindows": "node \"${PLUGIN_ROOT}/hooks/runtime-hook.mjs\" ensure-backend",
            "statusMessage": "Checking MemoraX Code backend",
            "timeout": 35
          },
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/runtime-hook.mjs\" capture-cwd",
            "commandWindows": "node \"${PLUGIN_ROOT}/hooks/runtime-hook.mjs\" capture-cwd",
            "statusMessage": "Capturing MemoraX Code workspace"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/runtime-hook.mjs\" capture-cwd",
            "commandWindows": "node \"${PLUGIN_ROOT}/hooks/runtime-hook.mjs\" capture-cwd",
            "statusMessage": "Capturing MemoraX Code workspace"
          },
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/runtime-hook.mjs\" memory-skill-reminder",
            "commandWindows": "node \"${PLUGIN_ROOT}/hooks/runtime-hook.mjs\" memory-skill-reminder",
            "statusMessage": "Recording MemoraX Code turn and checking reminders",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/runtime-hook.mjs\" capture-cwd",
            "commandWindows": "node \"${PLUGIN_ROOT}/hooks/runtime-hook.mjs\" capture-cwd",
            "statusMessage": "Capturing MemoraX Code workspace"
          },
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/runtime-hook.mjs\" memory-writeback",
            "commandWindows": "node \"${PLUGIN_ROOT}/hooks/runtime-hook.mjs\" memory-writeback",
            "statusMessage": "Saving memory"
          }
        ]
      }
    ]
  }
}
